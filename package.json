{
  "name": "today-money",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/static.test.mjs tests/push.test.mjs tests/push-deploy.test.mjs tests/service-worker.test.mjs tests/day-closing.test.mjs tests/acf-calendar.test.mjs tests/acf-regressions.test.mjs tests/navigation-lifecycle.test.mjs tests/v11.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:crawl": "MM3_CRAWL_STRICT=1 node tests/crawl.mjs",
    "test:live": "node tests/live.mjs",
    "test:scenarios": "MM3_SCENARIOS_STRICT=1 node tests/scenarios.mjs",
    "test:amount": "MM3_AMOUNT_STRICT=1 node tests/amount-fields.mjs",
    "test:p0": "MM3_P0_STRICT=1 node tests/p0-flows.mjs",
    "test:remaining": "node tests/remaining-ops.mjs",
    "test:worker": "wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir ../test-results/worker-build && node tests/worker-runtime.mjs",
    "push:deploy": "node worker/deploy.mjs",
    "test:push-live": "node tests/push-production.mjs",
    "test:extra": "MM3_EXTRA_STRICT=1 node tests/extra-ui.mjs",
    "test:glass": "node tests/glass-v15.mjs",
    "test:ui-score": "node tests/ui-score.mjs",
    "test:monkey": "MM3_MONKEY_STRICT=1 node tests/monkey.mjs",
    "test:text": "MM3_TEXT_STRICT=1 node tests/text-layout.mjs"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "http_ece": "1.2.1",
    "miniflare": "5.20261006.0-alpha",
    "playwright": "1.62.1",
    "postcss": "8.5.29",
    "wrangler": "4.148.0"
  },
  "dependencies": {
    "web-push": "3.6.7"
  }
}
