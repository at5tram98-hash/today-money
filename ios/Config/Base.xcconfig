// My Money（今日のお金・iOS）の共通設定。
//
// 無料の Apple Account（Personal Team）で iPhone に入れるときは、
// 同じフォルダに Local.xcconfig を作り、次の2行を自分の値にする（Local.xcconfig は Git に入れない）。
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   MYMONEY_BUNDLE_ID = com.yourname.mymoney
//
// バンドル ID は世界で一意である必要がある（他の人と同じ ID だと署名に失敗する）。

MYMONEY_BUNDLE_ID = com.example.mymoney.$(USER:rfc1034identifier)
CODE_SIGN_STYLE = Automatic

#include? "Local.xcconfig"
